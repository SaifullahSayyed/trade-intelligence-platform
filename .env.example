# =============================================================
# Trade Intelligence Platform — Environment Configuration
# =============================================================
# Copy this file to .env and fill in strong passwords/keys.
# NEVER COMMIT .env TO VERSION CONTROL.
# =============================================================

# PostgreSQL Configuration
POSTGRES_DB=trade_intelligence
POSTGRES_USER=ti_user
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_env
POSTGRES_PORT=5432
DAGSTER_DB=dagster

# ClickHouse Configuration
CLICKHOUSE_DB=trade_intelligence
CLICKHOUSE_USER=ti_user
CLICKHOUSE_PASSWORD=change_this_to_a_secure_clickhouse_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# OpenSearch Configuration
# Note: Initial admin password must contain uppercase, lowercase, digit, and special char and be >= 8 chars.
OPENSEARCH_ADMIN_PASSWORD=AdminPass_1234!Secure
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601

# Keycloak Configuration
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_to_a_secure_keycloak_admin_password
KEYCLOAK_PORT=8080
GRAFANA_KEYCLOAK_CLIENT_SECRET=grafana_sso_client_secret_demo

# MinIO (Local S3-compatible Object Storage for Dev)
MINIO_ROOT_USER=ti_minio_admin
MINIO_ROOT_PASSWORD=change_this_to_a_secure_minio_secret_key_123
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Dagster Orchestration
DAGSTER_PORT=3001

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_grafana_password
GRAFANA_PORT=3000

# App & Ingestion Secrets (Optional / External)
OEC_BOTMARKET_API_KEY=optional_oec_botmarket_token
AWS_DATA_EXCHANGE_S3_BUCKET=
