# =============================================================
# Trade Intelligence Platform — Environment Configuration
# =============================================================
# Copy this file to .env:
#   cp .env.example .env
# All default values are configured to boot out-of-the-box in local dev.
# NEVER COMMIT .env TO VERSION CONTROL.
# =============================================================

# PostgreSQL Configuration
POSTGRES_DB=trade_intelligence
POSTGRES_USER=ti_user
POSTGRES_PASSWORD=ti_local_postgres_pass_2026!
POSTGRES_PORT=5432
DAGSTER_DB=dagster

# ClickHouse Configuration
CLICKHOUSE_DB=trade_intelligence
CLICKHOUSE_USER=ti_user
CLICKHOUSE_PASSWORD=ti_local_clickhouse_pass_2026!
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# OpenSearch Configuration
# Note: Initial admin password must contain uppercase, lowercase, digit, and special char and be >= 8 chars.
# Do NOT include substrings like "admin" in OPENSEARCH_ADMIN_PASSWORD or OpenSearch security plugin will reject it.
OPENSEARCH_ADMIN_PASSWORD=TradeIntel_2026!SecurePass
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601

# Keycloak Configuration
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=KeycloakAdmin_1234!Secure
KEYCLOAK_PORT=8080
GRAFANA_KEYCLOAK_CLIENT_SECRET=grafana_sso_client_secret_demo

# MinIO (Local S3-compatible Object Storage for Dev)
MINIO_ROOT_USER=ti_minio_admin
MINIO_ROOT_PASSWORD=MinioSecretKey_1234!Secure
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Dagster Orchestration
DAGSTER_PORT=3001

# Prometheus & Grafana Monitoring
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GrafanaAdmin_1234!Secure
GRAFANA_PORT=3002

# App & Ingestion Secrets (Optional / External)
OEC_BOTMARKET_API_KEY=bot_market_ak_QjylqrNpXevSWLC9oa2iXVQ6T6acyg_lQ2Ms8i-oOMM
AWS_DATA_EXCHANGE_S3_BUCKET=
